<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/boasVindasFragment">

    <!-- Ações globais: podem ser chamadas de qualquer tela do grafo. -->
    <action
        android:id="@+id/action_global_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/main_graph"
        app:popUpToInclusive="true" />

    <action
        android:id="@+id/action_global_to_modulos"
        app:destination="@id/modulosFragment" />

    <fragment
        android:id="@+id/boasVindasFragment"
        android:name="com.example.levit.BoasVindasFragment"
        android:label="BoasVindas"
        tools:layout="@layout/activity_main">

        <action
            android:id="@+id/action_boasVindas_to_login"
            app:destination="@id/loginFragment" />

        <action
            android:id="@+id/action_boasVindas_to_cadastro"
            app:destination="@id/cadastroFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.levit.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/activity_login">

        <action
            android:id="@+id/action_login_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/main_graph"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_login_to_cadastro"
            app:destination="@id/cadastroFragment" />

        <action
            android:id="@+id/action_login_to_recuperarSenha"
            app:destination="@id/recuperarSenhaFragment" />
    </fragment>

    <fragment
        android:id="@+id/cadastroFragment"
        android:name="com.example.levit.auth.CadastroFragment"
        android:label="Cadastro"
        tools:layout="@layout/activity_cadastro">

        <action
            android:id="@+id/action_cadastro_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/main_graph"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_cadastro_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/cadastroFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/recuperarSenhaFragment"
        android:name="com.example.levit.auth.RecuperarSenhaFragment"
        android:label="RecuperarSenha"
        tools:layout="@layout/activity_recuperar_senha" />

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.levit.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/activity_dashboard">

        <action
            android:id="@+id/action_dashboard_to_novoModulo"
            app:destination="@id/novoModuloFragment" />
    </fragment>

    <fragment
        android:id="@+id/modulosFragment"
        android:name="com.example.levit.ModulosFragment"
        android:label="Modulos"
        tools:layout="@layout/activity_modulos">

        <action
            android:id="@+id/action_modulos_to_novoModulo"
            app:destination="@id/novoModuloFragment" />
    </fragment>

    <fragment
        android:id="@+id/novoModuloFragment"
        android:name="com.example.levit.TabelaFormFragment"
        android:label="Tabela"
        tools:layout="@layout/fragment_tabela_form">
        <argument
            android:name="tabelaId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="modelo"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/equipeFragment"
        android:name="com.example.levit.EquipeFragment"
        android:label="Equipe"
        tools:layout="@layout/fragment_equipe" />

    <action
        android:id="@+id/action_global_to_equipe"
        app:destination="@id/equipeFragment"
        app:launchSingleTop="true"
        app:popUpTo="@id/dashboardFragment" />

    <fragment
        android:id="@+id/cargoFormFragment"
        android:name="com.example.levit.CargoFormFragment"
        android:label="Cargo"
        tools:layout="@layout/fragment_cargo_form">
        <argument
            android:name="cargoId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.example.levit.PerfilFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_perfil" />

    <action
        android:id="@+id/action_global_to_perfil"
        app:destination="@id/perfilFragment"
        app:launchSingleTop="true"
        app:popUpTo="@id/dashboardFragment" />

    <fragment
        android:id="@+id/registrosFragment"
        android:name="com.example.levit.ItensFragment"
        android:label="Itens"
        tools:layout="@layout/fragment_itens">
        <argument
            android:name="moduloId"
            app:argType="string" />
        <argument
            android:name="itemId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/redefinirSenhaFragment"
        android:name="com.example.levit.auth.RedefinirSenhaFragment"
        android:label="RedefinirSenha"
        tools:layout="@layout/fragment_redefinir_senha">
        <argument
            android:name="token"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/recrutamentoFragment"
        android:name="com.example.levit.RecrutamentoFragment"
        android:label="Recrutamento"
        tools:layout="@layout/fragment_recrutamento" />

    <fragment
        android:id="@+id/automacoesFragment"
        android:name="com.example.levit.AutomacoesFragment"
        android:label="Automações"
        tools:layout="@layout/fragment_automacoes" />

    <fragment
        android:id="@+id/automacaoFormFragment"
        android:name="com.example.levit.AutomacaoFormFragment"
        android:label="Automação"
        tools:layout="@layout/fragment_automacao_form">
        <argument
            android:name="moduloId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="automacaoId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/financeiroFragment"
        android:name="com.example.levit.FinanceiroFragment"
        android:label="Financeiro"
        tools:layout="@layout/fragment_financeiro">
        <argument
            android:name="moduloId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/relatoriosFragment"
        android:name="com.example.levit.RelatoriosFragment"
        android:label="Relatórios" />

    <fragment
        android:id="@+id/configuracoesFragment"
        android:name="com.example.levit.ConfiguracoesFragment"
        android:label="Configurações" />

</navigation>