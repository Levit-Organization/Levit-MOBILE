<?xml version="1.0" encoding="utf-8"?>
<!-- Topo da lista de itens: busca, "só os meus", filtros, lista/quadro, ordenação e abas do quadro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoBusca"
                style="@style/Levit.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/itens_buscar"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBusca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltrar"
                    style="@style/Levit.Botao.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="@string/itens_filtrar"
                    app:icon="@drawable/ic_tune"
                    app:iconSize="@dimen/icone_sm" />

                <CheckBox
                    android:id="@+id/cbSoMeus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/itens_so_meus"
                    android:textColor="@color/ink_soft"
                    android:textSize="@dimen/texto_sm" />
            </LinearLayout>

            <!-- Pesquisa avançada -->
            <LinearLayout
                android:id="@+id/painelFiltros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone" />

            <!-- Lista ou quadro -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupoVisao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLista"
                    style="@style/Levit.Botao.Segmento"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/itens_lista" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuadro"
                    style="@style/Levit.Botao.Segmento"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/itens_quadro" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoAgrupar"
                style="@style/Levit.Campo.Select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/itens_agrupar_por">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/acAgrupar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ordenar (os cabeçalhos clicáveis da tabela do web) -->
            <LinearLayout
                android:id="@+id/linhaOrdem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Levit.Campo.Select"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/itens_ordenar_por">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/acOrdem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/btnDirecao"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/material_icons"
                    android:gravity="center"
                    android:text="arrow_upward"
                    android:textColor="@color/primary"
                    android:textSize="20sp" />
            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/abasQuadro"
                style="@style/Levit.Abas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:tabGravity="start"
                app:tabMode="scrollable" />

</LinearLayout>
