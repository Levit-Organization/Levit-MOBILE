<?xml version="1.0" encoding="utf-8"?>
<!-- Configurações › Empresa e tabelas: logo, nome e o ícone de cada tabela. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout style="@style/Levit.Cfg.Cartao">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/uploader"
                layout="@layout/item_cfg_uploader" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp">

                <TextView
                    style="@style/Levit.Cfg.Titulo"
                    android:text="@string/cfg_empresa" />

                <TextView
                    android:id="@+id/tvRemover"
                    style="@style/Levit.Cfg.Remover"
                    android:text="@string/cfg_remover_logo" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvErroLogo"
            style="@style/Levit.AlertaCartao.Erro" />

        <TextView
            android:id="@+id/tvNomeEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_campo_leitura"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/texto_sm" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="@string/cfg_nome_empresa_indisponivel"
            android:textColor="@color/light_text"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Aparência das tabelas: o ícone vale para toda a equipe. -->
    <LinearLayout
        style="@style/Levit.Cfg.Cartao"
        android:layout_marginTop="24dp">

        <TextView
            style="@style/Levit.Cfg.Titulo"
            android:text="@string/cfg_aparencia" />

        <TextView
            style="@style/Levit.Cfg.Descricao"
            android:text="@string/cfg_aparencia_desc" />

        <LinearLayout
            android:id="@+id/llTabelas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp" />
    </LinearLayout>
</LinearLayout>
