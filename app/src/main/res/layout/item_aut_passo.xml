<?xml version="1.0" encoding="utf-8"?>
<!-- Um passo da execução: deu certo ou não, qual ação e a mensagem. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp">

    <TextView
        android:id="@+id/tvIcone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/material_icons"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        tools:ignore="RtlSymmetry">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/archivo_medium"
            android:textColor="@color/ink"
            android:textSize="@dimen/texto_sm" />

        <TextView
            android:id="@+id/tvMensagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/light_text"
            android:textSize="@dimen/texto_xs"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
