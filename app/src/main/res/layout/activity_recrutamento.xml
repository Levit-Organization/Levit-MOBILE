<?xml version="1.0" encoding="utf-8"?>
<!-- Recrutamento: mesmo conteúdo de RecrutamentoKanban.jsx, com uma aba por etapa no lugar das colunas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- PageHeader -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ivMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dashboard_menu_desc"
            android:padding="12dp"
            android:src="@drawable/ic_menu_hamburger"
            app:tint="@color/ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Levit.Texto.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rec_titulo" />

            <TextView
                android:id="@+id/tvSubtitulo"
                style="@style/Levit.Texto.Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rec_carregando" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopiarLink"
            style="@style/Levit.Botao.Icone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/rec_copiar_link"
            android:tooltipText="@string/rec_copiar_link"
            android:visibility="gone"
            app:icon="@drawable/ic_content_copy" />

        <FrameLayout
            android:id="@+id/flSino"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoVaga"
            style="@style/Levit.Campo.Select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/rec_vaga"
            app:startIconDrawable="@drawable/ic_briefcase">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/acVaga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoBusca"
            style="@style/Levit.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/rec_buscar"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBusca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNovaEtapa"
                style="@style/Levit.Botao.Secundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/rec_nova_etapa"
                app:icon="@drawable/ic_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNovoCandidato"
                style="@style/Levit.Botao.Primario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rec_novo_candidato"
                app:icon="@drawable/ic_person_add" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/abasEtapas"
        style="@style/Levit.Abas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:tabGravity="start"
        app:tabMode="scrollable" />

    <!-- Resultado da busca entra como cabeçalho fixo (item_rec_resultado_busca); candidatos são linhas recicladas. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
