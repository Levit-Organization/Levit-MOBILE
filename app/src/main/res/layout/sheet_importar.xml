<?xml version="1.0" encoding="utf-8"?>
<!-- ImportarPlanilha.jsx: escolher o arquivo, conferir as colunas (com prévia) e ver o resultado. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/archivo_bold"
            android:textColor="@color/ink"
            android:textSize="@dimen/texto_lg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:text="@string/imp_sub"
            android:textColor="@color/light_text"
            android:textSize="@dimen/texto_sm" />

        <TextView
            android:id="@+id/tvErro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_alerta_erro"
            android:padding="12dp"
            android:textColor="@color/danger"
            android:textSize="@dimen/texto_sm"
            android:visibility="gone" />

        <!-- 1. Arquivo -->
        <LinearLayout
            android:id="@+id/blocoArquivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/caixaArquivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_dashed_button"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/material_icons"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="upload_file"
                    android:textColor="@color/primary"
                    android:textSize="36sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvEscolher"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/archivo_semibold"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/texto_sm" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="4dp"
                    android:text="@string/imp_formatos"
                    android:textColor="@color/light_text"
                    android:textSize="@dimen/texto_xs" />
            </LinearLayout>

            <TextView
                style="@style/Levit.Importar.Subtitulo"
                android:text="@string/imp_como" />

            <TextView
                style="@style/Levit.Importar.Dica"
                android:text="@string/imp_dica_1" />

            <TextView
                style="@style/Levit.Importar.Dica"
                android:text="@string/imp_dica_2" />

            <TextView
                style="@style/Levit.Importar.Dica"
                android:text="@string/imp_dica_3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                style="@style/Levit.Importar.Botao"
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:text="@string/acao_cancelar" />
        </LinearLayout>

        <!-- 2. Conferir -->
        <LinearLayout
            android:id="@+id/blocoConferir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvResumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:textColor="@color/ink_soft"
                android:textSize="@dimen/texto_sm" />

            <LinearLayout
                android:id="@+id/llMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoSelos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp" />

            <TextView
                android:id="@+id/tvPrevia"
                style="@style/Levit.Importar.Subtitulo"
                android:text="@string/imp_previa" />

            <LinearLayout
                android:id="@+id/llPrevia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvNaoVaoEntrar"
                style="@style/Levit.Importar.Subtitulo"
                android:text="@string/imp_nao_vao_entrar" />

            <LinearLayout
                android:id="@+id/llProblemas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:text="@string/imp_sem_automacoes"
                android:textColor="@color/light_text"
                android:textSize="@dimen/texto_xs" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrocar"
                    style="@style/Levit.Importar.Botao"
                    android:layout_width="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/imp_trocar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportar"
                    style="@style/Levit.Importar.Botao.Primario"
                    android:layout_width="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Resultado -->
        <LinearLayout
            android:id="@+id/blocoResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:textSize="@dimen/texto_sm" />

            <TextView
                android:id="@+id/tvFicaramDeFora"
                style="@style/Levit.Importar.Subtitulo"
                android:paddingTop="12dp" />

            <LinearLayout
                android:id="@+id/llErros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConcluir"
                style="@style/Levit.Importar.Botao.Primario"
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:text="@string/imp_concluir" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
