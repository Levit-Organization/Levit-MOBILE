<?xml version="1.0" encoding="utf-8"?>
<!-- Uma tabela e o nível de acesso do cargo nela (Sem acesso / Só ver / Editar / Tudo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tvTabela"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ink"
        android:textSize="@dimen/texto_sm" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campoNivel"
        style="@style/Levit.Campo.Select"
        android:layout_width="150dp"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/acNivel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textSize="@dimen/texto_sm" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
