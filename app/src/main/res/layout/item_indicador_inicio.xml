<?xml version="1.0" encoding="utf-8"?>
<!-- StatCard.jsx do Início: ícone colorido, número, rótulo e dica. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Levit.Inicio.Cartao"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvIcone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_caixa_icone"
        android:fontFamily="@font/material_icons"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/archivo_bold"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/ink"
                android:textSize="26sp" />

            <FrameLayout
                android:id="@+id/flSelo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRotulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/texto_sm" />

        <TextView
            android:id="@+id/tvDica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/light_text"
            android:textSize="@dimen/texto_xs" />
    </LinearLayout>
</LinearLayout>
