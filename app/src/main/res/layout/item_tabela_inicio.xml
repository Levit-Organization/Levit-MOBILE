<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de "Suas tabelas" no Início. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tvIcone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_caixa_icone"
        android:backgroundTint="@color/primary_100"
        android:fontFamily="@font/material_icons"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:textColor="@color/primary"
        android:textSize="24sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <TextView
            android:id="@+id/tvNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/archivo_semibold"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="@dimen/texto_sm" />

        <TextView
            android:id="@+id/tvItens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/light_text"
            android:textSize="@dimen/texto_xs" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/material_icons"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:text="arrow_forward"
        android:textColor="@color/faint"
        android:textSize="20sp"
        tools:ignore="HardcodedText" />
</LinearLayout>
