<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de PainelPrazos.jsx: ícone da tabela, título, tabela · coluna · data e responsável. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:drawable/list_selector_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvIcone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_caixa_icone"
        android:backgroundTint="@color/primary_50"
        android:fontFamily="@font/material_icons"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:textColor="@color/primary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/archivo_semibold"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="@dimen/texto_sm" />

        <TextView
            android:id="@+id/tvDetalhe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/light_text"
            android:textSize="@dimen/texto_xs" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/flResponsavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
