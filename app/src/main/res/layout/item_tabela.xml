<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de tabela (Modules.jsx): ícone, nome, quantos itens; editar e excluir sempre à mostra no toque. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="6dp">

    <LinearLayout
        android:id="@+id/areaAbrir"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvIcone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_rounded_square"
            android:backgroundTint="@color/primary_100"
            android:fontFamily="@font/material_icons"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/primary"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/archivo_semibold"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="@dimen/texto_sm" />

            <TextView
                android:id="@+id/tvItens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/light_text"
                android:textSize="@dimen/texto_xs" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditar"
        style="@style/Levit.Botao.Icone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_edit" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExcluir"
        style="@style/Levit.Botao.Icone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_delete_outline" />
</LinearLayout>
