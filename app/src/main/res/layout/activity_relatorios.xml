<?xml version="1.0" encoding="utf-8"?>
<!-- Relatórios: Painel, Montar relatório e Históricos (Relatorios.jsx), com o mesmo período para os três. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ivMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dashboard_menu_desc"
            android:padding="12dp"
            android:src="@drawable/ic_menu_hamburger"
            app:tint="@color/ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Levit.Texto.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rel_titulo" />

            <TextView
                style="@style/Levit.Texto.Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rel_subtitulo" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNovoRelatorio"
            style="@style/Levit.Botao.Primario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:contentDescription="@string/rel_novo"
            android:visibility="gone"
            app:icon="@drawable/ic_add"
            app:iconPadding="0dp" />

        <FrameLayout
            android:id="@+id/flSino"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/abas"
        style="@style/Levit.Abas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabGravity="fill"
        app:tabMode="fixed" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SeletorPeriodo -->
            <LinearLayout
                android:id="@+id/llPeriodo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Levit.Campo.Select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/rel_periodo"
                    app:startIconDrawable="@drawable/ic_calendar">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/acAtalho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Levit.Campo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:hint="@string/rel_de">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etInicio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Levit.Campo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/rel_ate">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFim"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPeriodoErro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/rel_periodo_invalido"
                    android:textColor="@color/danger"
                    android:textSize="@dimen/texto_sm"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- MontarRelatorio: escolhas -->
            <LinearLayout
                android:id="@+id/llMontar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Levit.Campo.Select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/rel_tabela">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/acTabela"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoAgrupar"
                    style="@style/Levit.Campo.Select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/rel_agrupar_por">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/acAgrupar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Levit.Campo.Select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/rel_calcular">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/acCalcular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoValor"
                    style="@style/Levit.Campo.Select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/rel_coluna_numero">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/acValor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchPeriodo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/texto_sm" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rel_so_periodo_desc"
                    android:textColor="@color/light_text"
                    android:textSize="@dimen/texto_xs" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llConteudo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
