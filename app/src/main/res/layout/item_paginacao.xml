<?xml version="1.0" encoding="utf-8"?>
<!-- Paginação (25 por página, como o web): rodapé fixo das listas de itens e de automações. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/linhaPaginas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnterior"
                    style="@style/Levit.Botao.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="@string/itens_anterior" />

                <TextView
                    android:id="@+id/tvPagina"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/light_text"
                    android:textSize="@dimen/texto_xs" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProxima"
                    style="@style/Levit.Botao.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="@string/itens_proxima" />
            </LinearLayout>
</FrameLayout>
