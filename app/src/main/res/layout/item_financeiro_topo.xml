<?xml version="1.0" encoding="utf-8"?>
<!-- Topo da lista do financeiro: SummaryCards e filtros (FinancialModule.jsx). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <include android:id="@+id/resEntradas" layout="@layout/item_resumo_financeiro" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <include android:id="@+id/resSaidas" layout="@layout/item_resumo_financeiro" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <include android:id="@+id/resSaldo" layout="@layout/item_resumo_financeiro" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Levit.Campo.Select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/fin_filtrar_categoria">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/acCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Levit.Campo.Select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/fin_ano"
                    app:startIconDrawable="@drawable/ic_calendar">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/acAno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Levit.Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/fin_buscar"
                    app:endIconMode="clear_text"
                    app:placeholderText="@string/fin_buscar_ex"
                    app:startIconDrawable="@drawable/ic_search">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBusca"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
</LinearLayout>
