<?xml version="1.0" encoding="utf-8"?>
<!-- Cabeçalho fixo da lista da Equipe: filtros (Colaboradores) ou "Criar cargo" (Cargos). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Filtros da aba Colaboradores -->
    <LinearLayout
        android:id="@+id/llFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Levit.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/eq_buscar"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBusca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Levit.Campo.Select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/eq_filtrar_cargo">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/acFiltroCargo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Ação da aba Cargos -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCriarCargo"
        style="@style/Levit.Botao.Secundario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="12dp"
        android:text="@string/eq_criar_cargo"
        android:visibility="gone"
        app:icon="@drawable/ic_add" />
</LinearLayout>
