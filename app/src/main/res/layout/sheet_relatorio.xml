<?xml version="1.0" encoding="utf-8"?>
<!-- FormularioRelatorio de Relatorios.jsx. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:id="@+id/tvTitulo" style="@style/Levit.Folha.Titulo" />
        <TextView style="@style/Levit.Folha.Subtitulo" android:text="@string/rel_form_sub" />

        <TextView android:id="@+id/tvErro" style="@style/Levit.Alerta.Erro" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Levit.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/rel_nome"
            app:placeholderText="@string/rel_nome_ex">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="100" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/archivo_medium"
            android:text="@string/rel_frequencia"
            android:textColor="@color/ink"
            android:textSize="@dimen/texto_sm" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grupoFrequencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiario"
                style="@style/Levit.Botao.Segmento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rel_diario" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSemanal"
                style="@style/Levit.Botao.Segmento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rel_semanal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMensal"
                style="@style/Levit.Botao.Segmento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rel_mensal" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoDia"
            style="@style/Levit.Campo.Select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/acDia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvCobre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/light_text"
            android:textSize="@dimen/texto_xs" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/archivo_medium"
            android:text="@string/rel_o_que_entra"
            android:textColor="@color/ink"
            android:textSize="@dimen/texto_sm" />

        <LinearLayout
            android:id="@+id/llSecoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/archivo_medium"
            android:text="@string/rel_quem_recebe"
            android:textColor="@color/ink"
            android:textSize="@dimen/texto_sm" />

        <LinearLayout
            android:id="@+id/llPessoas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAtivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/rel_ligado"
            android:textColor="@color/ink"
            android:textSize="@dimen/texto_sm" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rel_ligado_desc"
            android:textColor="@color/light_text"
            android:textSize="@dimen/texto_xs" />

        <LinearLayout style="@style/Levit.Rodape">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                style="@style/Levit.Botao.Secundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/acao_cancelar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalvar"
                style="@style/Levit.Botao.Primario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
