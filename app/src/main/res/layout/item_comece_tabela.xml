<?xml version="1.0" encoding="utf-8"?>
<!-- Início sem tabelas: os modelos para começar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Levit.Inicio.Cartao"
    android:layout_marginTop="0dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/archivo_semibold"
        android:text="@string/ini_comece"
        android:textColor="@color/ink"
        android:textSize="@dimen/texto_sm" />

    <TextView
        style="@style/Levit.Inicio.Texto"
        android:paddingTop="4dp"
        android:text="@string/ini_comece_desc" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/grupoModelos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp" />
</LinearLayout>
