<?xml version="1.0" encoding="utf-8"?>
<!-- Indicador de Graficos.jsx: sem caixa própria, vive dentro do card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tvIndicadorRotulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/light_text"
        android:textSize="@dimen/texto_sm" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIndicadorValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/archivo_bold"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/ink"
            android:textSize="@dimen/texto_2xl" />

        <TextView
            android:id="@+id/tvIndicadorVariacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/archivo_semibold"
            android:fontFeatureSettings="tnum"
            android:textSize="@dimen/texto_xs" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvIndicadorDica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/light_text"
        android:textSize="@dimen/texto_2xs" />
</LinearLayout>
