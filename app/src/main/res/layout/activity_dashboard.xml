<?xml version="1.0" encoding="utf-8"?>
<!-- Início: mesmo conteúdo de Dashboard.jsx (prazos e atenção primeiro, depois as tabelas). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/ivMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dashboard_menu_desc"
            android:padding="12dp"
            android:src="@drawable/ic_menu_hamburger"
            app:tint="@color/ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSaudacao"
                style="@style/Levit.Texto.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvData"
                style="@style/Levit.Texto.Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/flSino"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Carregando (skeleton) -->
            <LinearLayout
                android:id="@+id/llCarregando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/llConteudo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- INDICADORES (StatCard) -->
                <include android:id="@+id/indTabelas" layout="@layout/item_indicador_inicio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" />
                <include android:id="@+id/indAutomacoes" layout="@layout/item_indicador_inicio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
                <include android:id="@+id/indEquipe" layout="@layout/item_indicador_inicio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />

                <!-- PRAZOS (PainelPrazos.jsx) -->
                <LinearLayout style="@style/Levit.Inicio.Cartao">

                    <LinearLayout style="@style/Levit.Inicio.TituloLinha">

                        <TextView
                            style="@style/Levit.Inicio.Titulo"
                            android:text="@string/ini_prazos" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/grupoEscopo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMeus"
                                style="@style/Levit.Inicio.Segmento"
                                android:text="@string/ini_meus" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDaEquipe"
                                style="@style/Levit.Inicio.Segmento"
                                android:text="@string/ini_da_equipe" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llPrazos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- PRECISA DA SUA ATENÇÃO -->
                <LinearLayout style="@style/Levit.Inicio.Cartao">

                    <LinearLayout style="@style/Levit.Inicio.TituloLinha">

                        <TextView
                            style="@style/Levit.Inicio.Titulo"
                            android:text="@string/ini_atencao" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llAtencao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- SUAS TABELAS -->
                <LinearLayout
                    style="@style/Levit.Inicio.TituloLinha"
                    android:layout_marginTop="24dp">

                    <TextView
                        style="@style/Levit.Inicio.Titulo"
                        android:text="@string/ini_suas_tabelas" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNovaTabela"
                        style="@style/Levit.Inicio.BotaoPequeno"
                        android:text="@string/tab_nova"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llTabelas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvVerTodas"
                    style="@style/Levit.Inicio.Link"
                    android:visibility="gone" />

                <!-- RECRUTAMENTO (resumo) -->
                <LinearLayout
                    style="@style/Levit.Inicio.Cartao"
                    android:layout_marginTop="24dp">

                    <LinearLayout style="@style/Levit.Inicio.TituloLinha">

                        <TextView
                            style="@style/Levit.Inicio.Titulo"
                            android:text="@string/ini_recrutamento" />

                        <TextView
                            android:id="@+id/tvAbrirRecrutamento"
                            style="@style/Levit.Inicio.Link" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRecrutamento"
                        style="@style/Levit.Inicio.Texto" />

                    <LinearLayout
                        android:id="@+id/llCarregandoVaga"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/llBarraFunil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="12dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/grupoLegenda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        app:chipSpacingVertical="2dp" />
                </LinearLayout>

                <!-- EQUIPE (resumo) -->
                <LinearLayout
                    style="@style/Levit.Inicio.Cartao"
                    android:layout_marginTop="12dp">

                    <LinearLayout style="@style/Levit.Inicio.TituloLinha">

                        <TextView
                            style="@style/Levit.Inicio.Titulo"
                            android:text="@string/ini_equipe" />

                        <TextView
                            android:id="@+id/tvVerEquipe"
                            style="@style/Levit.Inicio.Link"
                            android:text="@string/ini_ver_equipe" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEquipe"
                        style="@style/Levit.Inicio.Texto" />

                    <LinearLayout
                        android:id="@+id/linhaSoVoce"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            style="@style/Levit.Inicio.Texto"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/ini_so_voce" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConvidar"
                            style="@style/Levit.Inicio.BotaoPequeno"
                            android:text="@string/ini_convidar"
                            app:icon="@drawable/ic_person_add" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linhaAvatares"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/llAvatares"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/tvPessoas"
                            style="@style/Levit.Inicio.Texto"
                            android:paddingStart="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
