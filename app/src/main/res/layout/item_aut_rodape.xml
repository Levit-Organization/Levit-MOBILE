<?xml version="1.0" encoding="utf-8"?>
<!-- Testar, Cancelar, Salvar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="20dp"
    android:paddingBottom="8dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTestar"
        style="@style/Levit.BotaoSolto.Fantasma"
        android:text="@string/aut_testar"
        app:icon="@drawable/ic_science" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelar"
        style="@style/Levit.BotaoSolto.Secundario"
        android:layout_marginEnd="8dp"
        android:text="@string/acao_cancelar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalvar"
        style="@style/Levit.BotaoSolto.Primario"
        android:text="@string/aut_salvar" />
</LinearLayout>
