<?xml version="1.0" encoding="utf-8"?>
<!-- Configurações › Perfil: dados do perfil e troca de senha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout style="@style/Levit.Cfg.Cartao">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/uploader"
                layout="@layout/item_cfg_uploader" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp">

                <TextView
                    style="@style/Levit.Cfg.Titulo"
                    android:text="@string/cfg_info_perfil" />

                <TextView
                    android:id="@+id/tvRemover"
                    style="@style/Levit.Cfg.Remover"
                    android:text="@string/cfg_remover_foto" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvErroImagem"
            style="@style/Levit.AlertaCartao.Erro" />

        <include
            android:id="@+id/campoNome"
            layout="@layout/item_campo_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/campoEmail"
            layout="@layout/item_campo_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/campoTelefone"
            layout="@layout/item_campo_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/campoLinkedin"
            layout="@layout/item_campo_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/campoBio"
            layout="@layout/item_campo_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvAvisoPerfil"
            style="@style/Levit.AlertaCartao.Aviso"
            android:text="@string/cfg_aviso_perfil" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvar"
            style="@style/Levit.BotaoSolto.Primario"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:text="@string/cfg_salvar_alteracoes" />
    </LinearLayout>

    <!-- Senha: só valida; o backend ainda não tem endpoint de troca. -->
    <LinearLayout
        style="@style/Levit.Cfg.Cartao"
        android:layout_marginTop="24dp">

        <TextView
            style="@style/Levit.Cfg.Titulo"
            android:text="@string/cfg_senha" />

        <include
            android:id="@+id/campoSenhaAtual"
            layout="@layout/item_campo_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/campoNovaSenha"
            layout="@layout/item_campo_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/campoConfirmar"
            layout="@layout/item_campo_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvErroSenha"
            style="@style/Levit.AlertaCartao.Erro" />

        <TextView
            android:id="@+id/tvAvisoSenha"
            style="@style/Levit.AlertaCartao.Aviso"
            android:text="@string/cfg_aviso_senha" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAtualizarSenha"
            style="@style/Levit.BotaoSolto.Secundario"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:text="@string/cfg_atualizar_senha" />
    </LinearLayout>
</LinearLayout>
