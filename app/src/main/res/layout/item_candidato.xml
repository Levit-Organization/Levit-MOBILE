<?xml version="1.0" encoding="utf-8"?>
<!-- KanbanCard.jsx: área que abre o perfil, detalhes e o seletor de etapa no rodapé. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/areaPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:fontFamily="@font/archivo_semibold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textSize="@dimen/texto_xs" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNome"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/archivo_semibold"
                        android:maxLines="1"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/texto_sm" />

                    <ImageView
                        android:id="@+id/ivCurriculo"
                        android:layout_width="@dimen/icone_selo"
                        android:layout_height="@dimen/icone_selo"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/rec_enviou_curriculo"
                        android:src="@drawable/ic_attach_file"
                        app:tint="@color/light_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetalhe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/light_text"
                    android:textSize="@dimen/texto_xs" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linhaTempo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDesde"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/light_text"
                android:textSize="@dimen/texto_2xs" />

            <FrameLayout
                android:id="@+id/flParado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMover"
        style="@style/Levit.Botao.Secundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:gravity="start|center_vertical"
        android:minHeight="36dp"
        android:textSize="@dimen/texto_xs"
        app:icon="@drawable/ic_swap_horiz"
        app:iconSize="@dimen/icone_sm" />
</LinearLayout>
