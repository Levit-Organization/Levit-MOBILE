<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hamburgerDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contentor onde o layout específico da página (ex: activity_dashboard) será injetado -->
    <FrameLayout
        android:id="@+id/pageContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- O Menu Hambúrguer Lateral -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/hamburgerNavigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_levit"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>