<?xml version="1.0" encoding="utf-8"?>
<!-- BotaoNotificacoes: sino com o contador de não lidas. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sino"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvIcone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:fontFamily="@font/material_icons"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:text="notifications_none"
        android:textColor="@color/light_text"
        android:textSize="22sp"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/tvContador"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/bg_pilula"
        android:backgroundTint="@color/danger"
        android:fontFamily="@font/archivo_bold"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:minWidth="18dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:visibility="gone" />
</FrameLayout>
