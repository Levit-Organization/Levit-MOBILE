<?xml version="1.0" encoding="utf-8"?>
<!-- Mostrar itens que atendem a [todos | qualquer um] dos filtros. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/filtro_mostrar_que_atendem"
        android:textColor="@color/ink_soft"
        android:textSize="@dimen/texto_sm" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTodos"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/segmento_fundo"
            android:text="@string/filtro_todos"
            android:textAllCaps="false"
            android:textColor="@color/segmento_texto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQualquer"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/segmento_fundo"
            android:text="@string/filtro_qualquer"
            android:textAllCaps="false"
            android:textColor="@color/segmento_texto" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/filtro_os_filtros"
        android:textColor="@color/ink_soft"
        android:textSize="@dimen/texto_sm" />
</LinearLayout>
