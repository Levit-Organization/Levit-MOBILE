<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer "Convidar para a equipe" / "Editar colaborador" de TeamManagement.jsx. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:id="@+id/tvTitulo" style="@style/Levit.Folha.Titulo" />

        <TextView android:id="@+id/tvErro" style="@style/Levit.Alerta.Erro" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_alerta_info"
            android:padding="12dp"
            android:text="@string/eq_convite_info"
            android:textColor="@color/info"
            android:textSize="@dimen/texto_sm" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoNome"
            style="@style/Levit.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/eq_nome_colaborador">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoEmail"
            style="@style/Levit.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/eq_email_colaborador"
            app:placeholderText="@string/eq_email_ex">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoCargo"
            style="@style/Levit.Campo.Select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/eq_cargo">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/acCargo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoMensagem"
            style="@style/Levit.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/eq_mensagem"
            app:counterEnabled="true"
            app:counterMaxLength="500"
            app:helperText="@string/eq_mensagem_dica"
            app:placeholderText="@string/eq_mensagem_ex">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout style="@style/Levit.Rodape">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                style="@style/Levit.Botao.Secundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/acao_cancelar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalvar"
                style="@style/Levit.Botao.Primario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
