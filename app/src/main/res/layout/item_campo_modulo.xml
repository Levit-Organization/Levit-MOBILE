<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_icon_option_unselected"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/ivTipoCampo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:tint="@color/levit_purple" />

    <EditText
        android:id="@+id/etNomeCampo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_edit_text"
        android:hint="@string/campo_nome_hint"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/levit_text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvTipoCampoBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_badge_pill"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/levit_purple"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/btnRemoverCampo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/campo_remover_desc"
        android:padding="14dp"
        android:src="@drawable/ic_close"
        android:tint="@color/levit_hint" />

</LinearLayout>
