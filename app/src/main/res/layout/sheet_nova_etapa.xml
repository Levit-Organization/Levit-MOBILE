<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView style="@style/Levit.Folha.Titulo" android:text="@string/rec_nova_etapa" />
    <TextView style="@style/Levit.Folha.Subtitulo" android:text="@string/rec_nova_etapa_sub" />

    <TextView android:id="@+id/tvErro" style="@style/Levit.Alerta.Erro" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campoVaga"
        style="@style/Levit.Campo.Select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/rec_vaga">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/acVaga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campoNome"
        style="@style/Levit.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/rec_nome_etapa"
        app:placeholderText="@string/rec_nome_etapa_ex">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout style="@style/Levit.Rodape">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelar"
            style="@style/Levit.Botao.Secundario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/acao_cancelar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvar"
            style="@style/Levit.Botao.Primario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/rec_criar_etapa" />
    </LinearLayout>
</LinearLayout>
