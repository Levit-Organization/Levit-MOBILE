<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Release: só HTTPS e só certificados do sistema (sem CA instalada pelo
        usuário). O debug libera HTTP em src/debug/res/xml.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
