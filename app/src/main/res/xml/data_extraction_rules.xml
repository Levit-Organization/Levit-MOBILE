<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nada do app vai para o backup na nuvem nem para a transferência
    entre aparelhos. A sessão é cifrada com uma chave do Keystore que não sai do
    aparelho, então restaurá-la em outro só quebraria; quem troca de celular
    entra de novo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
